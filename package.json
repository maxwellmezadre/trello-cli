{
  "name": "@maxwellmezadre/trello-cli",
  "version": "0.2.0",
  "description": "Trello CLI que embute um servidor MCP e uma Skill, sobre um núcleo compartilhado",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxwellmezadre/trello-cli.git"
  },
  "homepage": "https://github.com/maxwellmezadre/trello-cli#readme",
  "keywords": ["trello", "cli", "mcp", "attachments", "claude"],
  "bin": {
    "trello": "./dist/bin.js",
    "trello-mcp": "./dist/mcp-bin.js"
  },
  "files": ["dist", "SKILL.md", "README.md", "LICENSE"],
  "exports": "./dist/bin.js",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun run src/bin.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:dist": "bun build src/bin.ts src/mcp-bin.ts --target=node --outdir dist",
    "build:binary": "bun build --compile src/bin.ts --outfile trello",
    "prepublishOnly": "bun run build:dist"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sinclair/typebox": "^0.34.49",
    "commander": "^15.0.0"
  }
}
